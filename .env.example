# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

SECRET_KEY=change-me-to-something-long-and-random
DEBUG=True

# SQL Server (leave DB_USER and DB_PASSWORD empty to use Windows Authentication)
DB_ENGINE=mssql
DB_NAME=ledgerly
DB_HOST=localhost
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# No SQL Server? Set DB_ENGINE=sqlite to run on a local file instead.

# Email (optional). Leave EMAIL_HOST empty and emails are printed in the
# terminal instead of being sent.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
