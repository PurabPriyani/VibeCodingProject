# Example environment settings for Ledgerly.
# The real values live in .env, which .gitignore keeps out of the repository
# so passwords are never committed.

# Django
SECRET_KEY=change-me-to-something-long-and-random
DEBUG=True

# Database. DB_ENGINE is "mssql" for SQL Server or "sqlite" for a local file.
# With DB_USER and DB_PASSWORD empty, SQL Server uses Windows Authentication.
DB_ENGINE=mssql
DB_NAME=ledgerly
DB_HOST=localhost
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Outgoing email over SMTP (Gmail works with an App Password).
# With EMAIL_HOST empty, emails are printed in the terminal instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
